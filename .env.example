# ═══════════════════════════════════════════════════════════════
# Argus — Open Agentic OSINT Platform
# ═══════════════════════════════════════════════════════════════

# ─── LLM Provider (pick one) ─────────────────────────────────
# Default: Kimi-K2 via Moonshot API (recommended — best tool-calling support)
LLM_PROVIDER=kimi-k2
MOONSHOT_API_KEY=your-moonshot-api-key

# Alternative: OpenAI
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o

# Alternative: Ollama (fully local, no API key)
# LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3

# ─── OSINT API Keys (optional — adapters work without them) ──
# SHODAN_API_KEY=your-shodan-key

# ─── Server Configuration ────────────────────────────────────
PORT=3100
UI_PORT=3000
